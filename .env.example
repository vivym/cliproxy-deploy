# Let's Encrypt account email.
ACME_EMAIL=admin@example.com

# Public hostnames. Each service is routed through Traefik with HTTPS.
AI_HOST=ai.x2r.store
CLIPROXY_HOST=cliproxy.x2r.store
CPA_USAGE_KEEPER_HOST=keeper.x2r.store

# Pin images after validation. Do not use GitHub's "Latest" marker blindly for New API.
NEW_API_IMAGE_TAG=v0.13.2
CLIPROXYAPI_IMAGE_TAG=replace-with-pinned-version
CPA_USAGE_KEEPER_IMAGE_TAG=v1.3.3
CPA_USAGE_KEEPER_IMAGE=ghcr.io/willxup/cpa-usage-keeper

# New API security. Generate unique values before launch:
# openssl rand -hex 32
NEW_API_SESSION_SECRET=replace-with-session-secret
NEW_API_CRYPTO_SECRET=replace-with-crypto-secret

# Postgres.
# Use URL-safe generated values because these passwords are embedded in DSN URLs.
# Prefer hex, for example: openssl rand -hex 24
POSTGRES_DB=newapi
POSTGRES_USER=newapi
POSTGRES_PASSWORD=replace-with-postgres-password

# Redis.
# Use URL-safe generated values because these passwords are embedded in DSN URLs.
# Prefer hex, for example: openssl rand -hex 24
REDIS_PASSWORD=replace-with-redis-password

# API key accepted by CLIProxyAPI. New API uses it for the upstream channel;
# direct public CLIProxyAPI clients and verification checks may also use it.
# Generate with: scripts/generate-api-key.py
# This must match config.yaml api-keys entry exactly after rendering/copying.
CLIPROXY_INTERNAL_API_KEY=replace-with-internal-new-api-channel-key

# CLIProxyAPI management key. Also used by CPA Usage Keeper to read usage queue.
# This must match config.yaml remote-management.secret-key exactly after rendering/copying.
MANAGEMENT_SECRET=replace-with-management-secret

# CPA Usage Keeper dashboard is public by default and protected by its login password.
CPA_USAGE_KEEPER_AUTH_ENABLED=true
CPA_USAGE_KEEPER_AUTH_PASSWORD=replace-with-keeper-password

# Backups are written outside the repository by scripts/backup-api-site.sh.
BACKUP_DIR=/var/backups/cliproxy-api-site

# Optional CLIProxyAPI request-log archiving to Cloudflare R2.
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY must be R2 API tokens with write access to the bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=replace-with-r2-bucket
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLIPROXY_LOG_ARCHIVE_R2_PREFIX=cliproxy-logs
CLIPROXY_LOG_ARCHIVE_MIN_AGE_MINUTES=30
CLIPROXY_LOG_ARCHIVE_DELETE_AFTER_DAYS=1
CLIPROXY_LOG_ARCHIVE_GZIP_LEVEL=1
CLIPROXY_LOG_ARCHIVE_NICE=19
CLIPROXY_LOG_ARCHIVE_IONICE_IDLE=true
# Optional hard CPU cap for gzip. Requires cpulimit on the host, for example 25.
CLIPROXY_LOG_ARCHIVE_CPU_LIMIT_PERCENT=

# Passed through for compatibility with the upstream CLIProxyAPI compose file.
# Leave empty for normal local/server filesystem deployment.
DEPLOY=
