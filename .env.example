# Traefik / HTTPS
ACME_EMAIL=admin@example.com
SUB2API_HOST=sub2api.example.com
SUB2API_ADMIN_HOST=admin.sub2api.example.com

# Core app settings
SUB2API_IMAGE_TAG=latest
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=
TZ=Asia/Shanghai
SUB2API_PROXY_SUBNET=172.31.10.0/24
SUB2API_BACKEND_SUBNET=172.31.11.0/24

# Optional runtime tuning
SERVER_MODE=release
RUN_MODE=standard
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

# Optional hardening / networking
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,api.kimi.com,open.bigmodel.cn,api.minimaxi.com,generativelanguage.googleapis.com,cloudcode-pa.googleapis.com,*.openai.azure.com
UPDATE_PROXY_URL=

# Optional New API sidecar. Use with docker-compose.newapi.yml.
# Generate passwords/secrets with openssl rand -hex 32 so DSN URL values stay URL-safe.
NEW_API_HOST=ai.example.com
NEW_API_IMAGE_TAG=v0.13.2
NEWAPI_POSTGRES_USER=newapi
NEWAPI_POSTGRES_DB=newapi
NEWAPI_POSTGRES_PASSWORD=
NEWAPI_REDIS_PASSWORD=
NEW_API_SESSION_SECRET=
NEW_API_CRYPTO_SECRET=

# Optional operations. BACKUP_DIR must be absolute and outside this repository.
BACKUP_DIR=/var/backups/sub2api
SUB2API_TEST_API_KEY=
NEW_API_TEST_API_KEY=
