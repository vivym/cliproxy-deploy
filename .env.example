# Public New API entry and TLS
ACME_EMAIL=admin@example.com
NEW_API_HOST=ai.example.com
NEW_API_IMAGE_REPOSITORY=
# Set a reviewed fork tag or tag@sha256 digest before deployment.
NEW_API_IMAGE_TAG=
NEW_API_POSTGRES_USER=new_api
NEW_API_POSTGRES_DB=new_api
NEW_API_POSTGRES_PASSWORD=
NEW_API_REDIS_PASSWORD=
NEW_API_SESSION_SECRET=
NEW_API_CRYPTO_SECRET=

# Optional Lark integration profile. Keep the listener blank during the base
# migration. Enabling it without valid mounted secrets fails closed.
NEW_API_INTEGRATION_LISTEN_ADDR=
# Set only during an integration credential rotation window.
NEW_API_LARK_INTEGRATION_SECRET_NEXT_FILE=
# The following repository defaults are for local builds only. Replace all three
# with repositories from the same reviewed release before production use.
LARK_CONTROLLER_IMAGE_REPOSITORY=new-api-lark-controller
LARK_CONTROLLER_IMAGE_TAG=local
LARK_CORRECTION_IMAGE_REPOSITORY=new-api-lark-correction
LARK_CORRECTION_IMAGE_TAG=local
LARK_CONFIG_IMAGE_REPOSITORY=new-api-lark-config
LARK_CONFIG_IMAGE_TAG=local
LARK_CONTROLLER_MODE=shadow
# Keep false during webhook-only shadow. Enable only when the Lark Custom OAuth
# provider is ready for a controlled employee pilot.
LARK_OAUTH_PUBLIC_ENABLED=false
LARK_RECONCILIATION_HEALTH_OPEN_ID=
LARK_RECONCILIATION_INTERVAL=24h
LARK_APPROVAL_RECONCILIATION_INTERVAL=15m
LARK_APPROVAL_RECONCILIATION_LOOKBACK=72h
LARK_OAUTH_RATE_LIMIT_PER_MINUTE=30
LARK_OAUTH_TRUSTED_PROXY_CIDRS=172.31.20.0/24
LARK_PROCESSING_LEASE_TIMEOUT=5m
LARK_PROCESSING_RECOVERY_INTERVAL=1m

# Internal Sub2API upstream and operator UI
SUB2API_ADMIN_HOST=admin.sub2api.example.com
SUB2API_IMAGE_TAG=latest
SUB2API_POSTGRES_USER=sub2api
SUB2API_POSTGRES_DB=sub2api
SUB2API_POSTGRES_PASSWORD=
SUB2API_REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=
TZ=Asia/Shanghai

# Deployment networks
EDGE_SUBNET=172.31.20.0/24
SUB2API_DATA_SUBNET=172.31.21.0/24
NEW_API_DATA_SUBNET=172.31.22.0/24
LARK_INTEGRATION_SUBNET=172.31.23.0/24
LARK_CONFIG_SUBNET=172.31.24.0/24
LARK_CONFIG_EGRESS_SUBNET=172.31.25.0/24

# Optional Sub2API runtime tuning
SERVER_MODE=release
RUN_MODE=standard
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

# Optional Sub2API hardening and upstream networking
SECURITY_URL_ALLOWLIST_ENABLED=true
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,api.kimi.com,open.bigmodel.cn,api.minimaxi.com,generativelanguage.googleapis.com,cloudcode-pa.googleapis.com,*.openai.azure.com
UPDATE_PROXY_URL=

# Optional operations. BACKUP_DIR must be absolute and outside this repository.
BACKUP_DIR=/var/backups/new-api
NEW_API_TEST_API_KEY=
