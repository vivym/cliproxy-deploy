# Server host/interface to bind to. Empty binds all interfaces inside the container.
host: ""
port: 8317

# TLS is terminated by Traefik, so CLIProxyAPI listens on internal HTTP.
tls:
  enable: false
  cert: ""
  key: ""

# Management API and bundled web control panel.
# CLIProxyAPI will hash a plaintext secret-key on startup and write it back to config.yaml.
# CLIProxyAPI is internal-only in the API-site deployment.
# Management stays enabled for internal container operations and usage queue AUTH.
# Do not expose /management.html or /v0/management/* publicly in production.
remote-management:
  allow-remote: true
  secret-key: "replace-with-management-secret"
  disable-control-panel: true
  panel-github-repository: "https://github.com/router-for-me/Cli-Proxy-API-Management-Center"

# Mounted to ./auths by docker-compose.yml.
auth-dir: "~/.cli-proxy-api"

# Client API keys accepted by CLIProxyAPI.
api-keys:
  - "replace-with-internal-new-api-channel-key"

debug: false

# Keep pprof private and disabled.
pprof:
  enable: false
  addr: "127.0.0.1:8316"

commercial-mode: false

# Production default is false. Enable request-log only during short troubleshooting windows.
logging-to-file: true
logs-max-total-size-mb: 2048
error-logs-max-files: 10
request-log: false

# Enables in-memory usage stats and the built-in Redis-compatible usage queue.
usage-statistics-enabled: true
redis-usage-queue-retention-seconds: 3600

# Keep proxy/routing defaults explicit so operators can see this deployment does
# not add an outbound proxy, force model prefixes, or pass client headers through.
proxy-url: ""
force-model-prefix: false
passthrough-headers: false

# Keep upstream retry defaults explicit; tune only after observing failures.
request-retry: 3
max-retry-credentials: 0
max-retry-interval: 30

# Prefer keeping a client session on the same upstream account when possible.
# CLIProxyAPI can still fail over if the bound credential becomes unavailable.
routing:
  strategy: "round-robin"
  session-affinity: true
  session-affinity-ttl: "2h"

# Require API-key authentication for /v1/ws WebSocket clients too.
ws-auth: true
